{
  "name": "onekeyjam",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://onekeyjam.netlify.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/abulka/onekeyjam.git"
  },
  "scripts": {
    "start": "vite",
    "predev": "node bin/generate-manifests.mjs",
    "dev": "vite",
    "prebuild": "node bin/generate-manifests.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5050",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate:data": "node bin/validate-data.mjs",
    "validate:scales": "node bin/check-project-scales.mjs",
    "regenerate:scales": "node bin/regenerate-project-scales.mjs",
    "generate:classic": "node bin/generate-classic-projects.mjs"
  },
  "dependencies": {
    "@globalhive/vuejs-tour": "^3.0.1",
    "@tonaljs/note": "4.6.5",
    "@tonaljs/tonal": "4.6.5",
    "@tonejs/midi": "^2.0.28",
    "lodash": "^4.18.1",
    "soundfont-player": "^0.12.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "webmidi": "^3.3.1"
  },
  "overrides": {
    "@tonaljs/abc-notation": "4.6.5",
    "@tonaljs/array": "4.6.5",
    "@tonaljs/chord": "4.6.5",
    "@tonaljs/chord-detect": "4.6.5",
    "@tonaljs/chord-type": "4.6.5",
    "@tonaljs/collection": "4.6.2",
    "@tonaljs/core": "4.6.5",
    "@tonaljs/duration-value": "4.6.2",
    "@tonaljs/interval": "4.6.5",
    "@tonaljs/key": "4.6.5",
    "@tonaljs/midi": "4.6.5",
    "@tonaljs/mode": "4.6.5",
    "@tonaljs/note": "4.6.5",
    "@tonaljs/pcset": "4.6.5",
    "@tonaljs/progression": "4.6.5",
    "@tonaljs/range": "4.6.5",
    "@tonaljs/roman-numeral": "4.6.5",
    "@tonaljs/scale": "4.6.5",
    "@tonaljs/scale-type": "4.6.5",
    "@tonaljs/time-signature": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "nodemon": "^3.1.14",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.3.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "fsevents": true
  }
}
