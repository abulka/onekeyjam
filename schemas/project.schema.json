{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://onekeyjam.netlify.app/schemas/project.schema.json",
  "title": "OneKeyJam Project",
  "description": "A project as stored in public/projects or exported/imported as JSON. Derived scale-note arrays may be present in-memory but are stripped when persisted.",
  "type": "object",
  "required": ["name", "chords"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["type", "version"],
      "properties": {
        "type": { "const": "onekeyjam" },
        "version": { "type": "number" },
        "source": { "type": "string" }
      }
    },
    "name": { "type": "string" },
    "chords": {
      "type": "array",
      "items": { "$ref": "#/definitions/chordConfig" }
    },
    "options": {
      "type": "object",
      "properties": {
        "key": {
          "description": "The declared musical key. type is a Tonal scale type; major and minor are the common values, modes such as dorian are allowed.",
          "type": "object",
          "required": ["tonic", "type"],
          "properties": {
            "tonic": { "type": "string" },
            "type": { "type": "string" },
            "source": { "enum": ["user", "detected"] }
          }
        },
        "soloMode": {
          "description": "'chord' follows the per-chord scales; 'key' keeps the right hand on the project key scale.",
          "enum": ["chord", "key"]
        },
        "colour": {
          "description": "How much chromatic colour the key-aware scale engine prefers when ranking chord scales.",
          "enum": ["diatonic", "jazz", "adventurous"]
        },
        "scaleStyle": {
          "description": "The named right-hand scale style (see src/lib/scaleStyles.js). 'custom' means the colour, policy and options have been hand-tuned.",
          "enum": ["manual-safe", "manual", "follow", "follow-safe", "follow-melody", "tension", "vary", "adventurous", "custom"]
        },
        "keyboard": { "type": "object" }
      }
    },
    "songs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "ids": { "type": "array", "items": { "$ref": "#/definitions/id" } },
          "favourites": { "type": "array", "items": { "$ref": "#/definitions/id" } },
          "blacklist": { "type": "array", "items": { "$ref": "#/definitions/id" } }
        }
      }
    },
    "chordSequences": { "type": "object" }
  },
  "definitions": {
    "id": {
      "description": "Chord config ids are normally numbers, but some hand-authored projects still use numeric strings. The app compares ids loosely, so both are accepted.",
      "type": ["number", "string"]
    },
    "chordConfig": {
      "description": "Chord configs in static projects may omit 'chord' and/or 'chordNotes'; expandChordConfig() derives the missing parts on load.",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string" },
        "chord": { "type": "string" },
        "chordNotes": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "string" },
        "bass": { "type": "string" },
        "bassNote": { "type": "string" },
        "scale1": { "type": "string" },
        "scale2": { "type": "string" },
        "scale3": { "type": "string" },
        "scale1Notes": { "type": "array", "items": { "type": "string" } },
        "scale2Notes": { "type": "array", "items": { "type": "string" } },
        "scale3Notes": { "type": "array", "items": { "type": "string" } },
        "scaleNotesOfChord": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
