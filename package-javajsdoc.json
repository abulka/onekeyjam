{
  "name": "onekeyjam",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "echo npm run dev",
    "predev": "node bin/generate-manifests.mjs",
    "dev": "vite",
    "prebuild": "node bin/generate-manifests.mjs",
    "build": "vite build",
    "server": "node server.js",
    "preview": "vite preview --port 5050",
    "test:unit": "vitest --environment jsdom",
    "test": "mocha 'test/**/*.js' --recursive --es-module-specifier-resolution=node",
    "node-detect": "node --es-module-specifier-resolution=node src/lib/node-test-parse-midi.js",
    "build-research": "esbuild 'research/d phrygian dominant tool scale/deriveDiatonicChordsViaEsbuild.js' --sourcemap --bundle --outfile=out.js",
    "build-dummy": "esbuild --help",
    "build-ls": "ls -l > /tmp/junk-ls.txt"
  },
  "dependencies": {
    "@globalhive/vuejs-tour": "^1.3.3",
    "@tonaljs/tonal": "^4.6.5",
    "@tonejs/midi": "^2.0.28",
    "express": "^4.18.1",
    "jquery": "^3.6.0",
    "lodash": "^4.17.21",
    "pinia": "^2.0.13",
    "soundfont-player": "^0.12.0",
    "vue": "^3.2.33",
    "vue-router": "^4.0.14",
    "webmidi": "^3.0.19"
  },
  "devDependencies": {
    "@types/node": "^17.0.31",
    "@vitejs/plugin-vue": "^2.3.1",
    "@vue/test-utils": "^2.0.0-rc.20",
    "autoprefixer": "^10.4.7",
    "better-docs": "^2.7.2",
    "esbuild": "^0.15.6",
    "eslint": "^8.23.0",
    "eslint-plugin-vue": "^9.4.0",
    "jsdoc-plantuml": "^1.0.2",
    "jsdom": "^19.0.0",
    "mocha": "^9.2.2",
    "node-plantuml": "^0.9.0",
    "nodemon": "^2.0.16",
    "postcss": "^8.4.14",
    "sass": "^1.52.1",
    "tailwindcss": "^3.0.24",
    "typescript": "^4.6.4",
    "vite": "^2.9.5",
    "vitest": "^0.9.3"
  }
}
