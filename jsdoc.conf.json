{
    "source": {
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "plugins": ["plugins/markdown", "node_modules/better-docs/typedef-import", "node_modules/jsdoc-plantuml"],
    "opts": {
        "tutorials": "./doco"
     },
     "plantuml": {
        "puml": {
          "create": false
        },
        "images": {
          "create": true,
          "destination": "jsdoc-out/images-plantuml",
          "defaultFormat": "svg"
        }
      },
      "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "search": true,
        "default": {
            "staticFiles": {
              "include": [
                  "./doco/images"
              ]
            }
        },
        "better-docs": {
            "name": "OneKeyJam Documentation",
            "logo": "",
            "title": "OneKeyJam Doc",
            "css": "jsdoc.style.css",
            "trackingCode": "",
	        "hideGenerator": false,
            "navLinks": [
                {
                    "label": "Github",
                    "href": "https://github.com/abulka/onekeyjam"
                },
                {
                    "label": "OneKeyJam App",
                    "href": "http://localhost:8080/"
                }
            ]
        }
    }          
}

